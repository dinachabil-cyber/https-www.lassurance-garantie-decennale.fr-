{% extends 'base.html.twig' %}

{% block title %}Merci - Assurance Décennale Électricien{% endblock %}

{% block body %}
    <div class="min-h-screen bg-gradient-to-br from-light via-surfaceHover to-light hero-pattern relative overflow-hidden py-20 lg:py-32">
        <div class="absolute inset-0 scanlines-bg opacity-30"></div>
        
        <div class="bg-orb w-96 h-96 bg-yellow-300 top-20 left-10 transition-all duration-1000 opacity-30 translate-y-0" style="animation-delay: 0s"></div>
        <div class="bg-orb w-80 h-80 bg-blue-300 bottom-20 right-10 transition-all duration-1000 delay-300 opacity-25 translate-y-0" style="animation-delay: -5s"></div>
        <div class="bg-orb w-60 h-60 bg-green-300 top-1/2 left-1/3 transition-all duration-1000 delay-500 opacity-20 translate-y-0" style="animation-delay: -10s"></div>
        
        <div class="absolute top-10 left-10 transition-all duration-1000 delay-200 opacity-30">
            <div class="w-16 h-16 bg-yellow-400 rounded-2xl shadow-lg flex items-center justify-center floating-animation">
                <i class="fas fa-shield-alt text-yellow-600 text-2xl"></i>
            </div>
        </div>
        <div class="absolute top-20 right-20 transition-all duration-1000 delay-400 opacity-25" style="animation-delay: -2s">
            <div class="w-20 h-20 bg-blue-400 rounded-full shadow-lg flex items-center justify-center floating-animation">
                <i class="fas fa-bolt text-blue-500 text-2xl"></i>
            </div>
        </div>
        <div class="absolute bottom-10 left-1/4 transition-all duration-1000 delay-600 opacity-20" style="animation-delay: -4s">
            <div class="w-12 h-12 bg-green-400 rounded-lg shadow-lg flex items-center justify-center floating-animation">
                <i class="fas fa-plug text-green-500 text-lg"></i>
            </div>
        </div>

        <div class="container mx-auto px-4 relative z-10">
            <div class="text-center">
                <div class="w-24 h-24 bg-success rounded-full flex items-center justify-center mx-auto mb-8">
                    <i class="fas fa-check text-white text-3xl"></i>
                </div>
                <h2 class="text-3xl font-bold text-gradient mb-6">Merci !</h2>
                <p class="text-gray-600 text-lg max-w-xl mx-auto">
                    Votre demande a été envoyée. Un expert vous contactera rapidement.
                </p>
                <div class="mt-10">
                   <a href="{{ path('app_home') }}" class="inline-block bg-gradient-to-r from-yellow-400 to-yellow-500 text-dark font-bold py-4 px-8 rounded-2xl hover:shadow-lg transition-all transform hover:scale-105 gradient-shine">
                        <i class="fas fa-home mr-2"></i> Retour à l'accueil
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}