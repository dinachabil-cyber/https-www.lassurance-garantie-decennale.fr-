<section class="py-20 bg-surface relative overflow-hidden">
    <div class="bg-orb w-64 h-64 bg-yellow-200 top-10 right-10" style="animation-delay: 0s"></div>
    <div class="bg-orb w-48 h-48 bg-blue-200 bottom-10 left-10" style="animation-delay: -7s"></div>

    <div class="container mx-auto px-4">

        {% if title is defined and title %}
            {% if isH1 is defined and isH1 %}
                <h1 class="text-3xl lg:text-4xl font-bold text-dark text-center mb-8 reveal">
                    {{ title }}
                </h1>
            {% else %}
                <h2 class="text-3xl lg:text-4xl font-bold text-dark text-center mb-8 reveal">
                    {{ title }}
                </h2>
            {% endif %}
        {% endif %}

        {% if introduction is defined and introduction %}
            <div class="text-lg text-gray-700 leading-relaxed text-center max-w-4xl mx-auto mb-16 reveal">
                {{ introduction|raw }}
            </div>
        {% endif %}

        <div class="max-w-6xl mx-auto space-y-8">
            {% for section in sections|default([]) %}
                {% set style_index = loop.index0 %}
                {% set icons = ['fa-euro-sign', 'fa-shield-alt', 'fa-user-clock', 'fa-question-circle'] %}
                {% set gradients = ['from-yellow-400 to-yellow-400/80', 'from-blue-500 to-blue-500/80', 'from-green-500 to-green-500/80', 'from-purple-500 to-purple-500/80'] %}
                {% set borders = ['border-yellow-200', 'border-blue-200', 'border-green-200', 'border-purple-200'] %}
                {% set icon = icons[style_index % 4] %}
                {% set gradient = gradients[style_index % 4] %}
                {% set border = borders[style_index % 4] %}
                
                <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-lg {{ border }} hover:shadow-xl transition-all duration-300 reveal hover-lift" style="animation-delay: {{ style_index * 0.1 }}s">
                    <div class="flex items-center gap-4 sm:gap-6 mb-4">
                        <div class="w-14 h-14 min-w-[56px] flex items-center justify-center bg-gradient-to-br {{ gradient }} rounded-2xl shadow-lg flex-shrink-0 icon-bounce" style="animation-delay: {{ style_index * 0.2 }}s">
                            <i class="fas {{ icon }} text-white text-xl"></i>
                        </div>

                        {% if section.title is defined and section.title %}
                            <h3 class="text-xl sm:text-2xl font-bold text-dark leading-tight">
                                {{ section.title }}
                            </h3>
                        {% endif %}
                    </div>

                    {% if section.content is defined and section.content %}
                        <div class="text-gray-700 leading-relaxed space-y-4 break-words">
                            {{ section.content|raw }}
                        </div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>

        {% if ctaText is defined and ctaText %}
            <div class="text-center mt-16 reveal">
                <a href="{{ ctaLink|default('#hero') }}" class="inline-block bg-gradient-to-r from-yellow-400 to-yellow-500 text-dark font-bold py-4 px-8 rounded-2xl hover:shadow-lg transition-all transform hover:scale-105 gradient-shine">
                    {{ ctaText }}
                </a>
            </div>
        {% endif %}

    </div>
</section>