{% set itemsPerPage = 5 %}
{% set totalPages = (items|length / itemsPerPage)|round(0, 'ceil') %}

<section class="py-20 bg-surface relative overflow-hidden">
    <div class="bg-orb w-80 h-80 bg-green-200 top-10 left-10" style="animation-delay: 0s"></div>
    <div class="bg-orb w-60 h-60 bg-purple-200 bottom-20 right-10" style="animation-delay: -8s"></div>

    <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">

            <div class="text-center mb-12 reveal">
                <h2 class="text-4xl font-bold text-dark mb-4">FAQ</h2>
                <div class="w-24 h-1 bg-yellow-400 mx-auto rounded-full"></div>
            </div>

            <div class="space-y-4" id="faq-container">

                {% for item in items|default([]) %}
                    {% set page = (loop.index0 / itemsPerPage)|round(0, 'floor') + 1 %}

                    <div
                        class="faq-item border border-gray-200 rounded-3xl overflow-hidden bg-white shadow-sm hover:shadow-xl transition-all duration-300 reveal hover-lift"
                        data-page="{{ page }}"
                        style="
                            animation-delay: {{ (loop.index0 % itemsPerPage) * 0.1 }}s;
                            {% if page != 1 %}display:none;{% endif %}
                        "
                    >
                        <button
                            onclick="toggleFAQ({{ loop.index0 }})"
                            class="w-full px-6 py-4 text-left flex justify-between items-center hover:bg-yellow-50 transition-colors faq-toggle"
                            data-index="{{ loop.index0 }}"
                        >
                            <span class="font-semibold text-dark">
                                {{ item.question }}
                            </span>

                            <i
                                class="fas fa-chevron-down text-yellow-500 transition-transform duration-300 faq-icon"
                                data-icon-index="{{ loop.index0 }}"
                            ></i>
                        </button>

                        <div
                            class="overflow-hidden transition-all duration-300 ease-in-out max-h-0 opacity-0 faq-content"
                            data-content-index="{{ loop.index0 }}"
                        >
                            <div class="px-6 py-4 bg-yellow-50 border-t border-gray-100">
                                <p class="text-gray-700 leading-relaxed">
                                    {{ item.answer }}
                                </p>
                            </div>
                        </div>

                    </div>

                {% endfor %}

            </div>

            {% if totalPages > 1 %}
                <div class="flex justify-center items-center gap-2 mt-10 flex-wrap">

                    <button
                        id="prevPage"
                        onclick="changePage(currentPage - 1)"
                        class="px-4 py-2 rounded-xl border border-gray-300 bg-white hover:bg-gray-100 disabled:opacity-40 disabled:cursor-not-allowed transition"
                    >
                        Previous
                    </button>

                    {% for i in 1..totalPages %}
                        <button
                            class="page-btn w-10 h-10 rounded-xl font-medium transition {{ i == 1 ? 'bg-yellow-400 text-black shadow-md' : 'bg-white border border-gray-300 hover:bg-yellow-50' }}"
                            data-page-btn="{{ i }}"
                            onclick="changePage({{ i }})"
                        >
                            {{ i }}
                        </button>
                    {% endfor %}

                    <button
                        id="nextPage"
                        onclick="changePage(currentPage + 1)"
                        class="px-4 py-2 rounded-xl border border-gray-300 bg-white hover:bg-gray-100 disabled:opacity-40 disabled:cursor-not-allowed transition"
                    >
                        Next
                    </button>

                </div>
            {% endif %}

        </div>
    </div>
</section>

<script>
let currentPage = 1;
const totalPages = {{ totalPages }};

function changePage(page) {

    if (page < 1 || page > totalPages) return;

    currentPage = page;

    document.querySelectorAll(".faq-item").forEach(item => {
        item.style.display = item.dataset.page == page ? "" : "none";
    });

    // Close all opened FAQs
    document.querySelectorAll(".faq-content").forEach(el => {
        el.classList.remove("max-h-96", "opacity-100");
        el.classList.add("max-h-0", "opacity-0");
    });

    document.querySelectorAll(".faq-icon").forEach(icon => {
        icon.classList.remove("rotate-180");
    });

    // Highlight current page
    document.querySelectorAll(".page-btn").forEach(btn => {
        btn.classList.remove("bg-yellow-400", "text-black", "shadow-md");
        btn.classList.add("bg-white", "border", "border-gray-300");
    });

    const active = document.querySelector(`[data-page-btn="${page}"]`);

    if (active) {
        active.classList.remove("bg-white", "border", "border-gray-300");
        active.classList.add("bg-yellow-400", "text-black", "shadow-md");
    }

    document.getElementById("prevPage").disabled = page === 1;
    document.getElementById("nextPage").disabled = page === totalPages;
}

document.addEventListener("DOMContentLoaded", function () {
    changePage(1);
});
</script>